# Root .gitignore for Ootday Monorepo

# Environment & Config
.env
.env.*
!.env.example
!.env.production

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.deps

# Laravel / PHP
vendor/
node_modules/
public/storage
public/hot
storage/*.key
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# IDE & OS Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Temp
*.log
scratch/
