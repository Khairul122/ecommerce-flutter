{
    "name": "ootday/backend-laravel",
    "type": "project",
    "description": "Backend REST API Ootday (menggantikan Firebase dan Backend_Ootday PHP lama)",
    "keywords": ["laravel", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "midtrans/midtrans-php": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": { "laravel": { "dont-discover": [] } },
    "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
